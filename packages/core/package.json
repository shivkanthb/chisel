{
  "name": "chisel-engine",
  "version": "0.2.2",
  "description": "Lightweight workflow engine on BullMQ and Redis",
  "author": "shivkanthb <hi@shiv.cv>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivkanthb/chisel.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shivkanthb/chisel",
  "bugs": "https://github.com/shivkanthb/chisel/issues",
  "keywords": [
    "workflow",
    "bullmq",
    "redis",
    "job-queue",
    "durable-execution",
    "background-jobs",
    "steps",
    "orchestration"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.mjs",
      "require": "./dist/adapters/hono.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "hono": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  },
  "files": ["dist"]
}
